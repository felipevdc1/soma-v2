# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# SOMA runtime artifacts (per-machine, not for distribution)
core/.snapshots/
core/logs/
core/evidence/
.snapshots/
logs/
evidence/

# .soma/ — ignore SELETIVO (spec 016 AC-11). Nunca ".soma/" inteiro: isso
# tiraria .soma/install-state.json do git, e o hydra depende dele rastreado
# para o fluxo de install distribuído (spec.md AC-03/AC-11). Só os
# artefatos de runtime de um `soma-run` são per-machine.
.soma/reports/
.soma/dispatches/
.soma/run-state-*.json
.soma.lock

# Local environment
.env
.env.local
.env.*.local

# Test scratch
/tmp/soma-v2-docker-test/
*.test-output
